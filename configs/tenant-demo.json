{
  "tenantId": "tenant-demo",
  "name": "Demo Tenant",
  "channels": {
    "whatsapp": {
      "phoneNumberId": "REPLACE_ME",
      "accessTokenSecretId": "REPLACE_ME"
    },
    "telegram": {
      "botTokenSecretId": "arn:aws:secretsmanager:us-east-1:293262438125:secret:telegram-bot-token-tenant-demo-dev-uaDZeE"
    }
  },
  "policy": {
    "contactPolicy": {
      "timezone": "America/Bogota",
      "maxContactsPerDay": 1,
      "noMultichannelSameWeekAfterDirectContact": true,
      "hours": {
        "monFri": {
          "from": "07:00",
          "to": "19:00"
        },
        "sat": {
          "from": "08:00",
          "to": "15:00"
        },
        "sunBlocked": true,
        "holidaysBlocked": true
      },
      "channelsAllowed": {
        "whatsapp": true,
        "telegram": true
      },
      "countryCode": "CO"
    },
    "contactLimitsByStage": {
      "EARLY": {
        "maxOutboundPerDay": 1,
        "maxOutboundPerWeek": 1
      },
      "MID": {
        "maxOutboundPerDay": 1,
        "maxOutboundPerWeek": 3
      },
      "LATE": {
        "maxOutboundPerDay": 1,
        "maxOutboundPerWeek": 4
      }
    },
    "cooldowns": {
      "rejectedOfferDays": 3,
      "noResponseDays": 2,
      "brokenPromiseDays": 1
    },
    "offerPolicy": {
      "ladder": [
        {
          "attempt": 1,
          "maxDiscountPct": 0
        },
        {
          "attempt": 2,
          "maxDiscountPct": 5
        },
        {
          "attempt": 3,
          "maxDiscountPct": 10
        }
      ],
      "maxAttempts": 6,
      "hardCapDiscountPct": 15
    },
    "auditPolicy": {
      "retentionDays": 90,
      "storeMessageText": true,
      "storeDecisionPayloads": true
    },
    "exportPolicy": {
      "enabled": false,
      "s3Bucket": "",
      "s3Prefix": "tenants/tenant-demo/audit/"
    },
    "notificationPolicy": {
      "email": {
        "enabled": true,
        "fromAddress": "adrian.710@hotmail.com",
        "toAddresses": [
          "andruxand@gmail.com"
        ],
        "subjectPrefix": "[CollectionsAI]",
        "includeInboundText": true
      }
    },
    "handoffPolicy": {
      "enabled": true,
      "stageMin": "MID",
      "intents": [
        "DISPUTE",
        "ANGRY"
      ],
      "retentionDays": 30,
      "storeInboundText": true
    },
    "tonePolicy": {
      "T1": "amable",
      "T2": "directo",
      "T3": "formal"
    },
    "strategyPolicy": {
      "defaultObjective": "NEGOTIATE",
      "objectivePlaybook": {
        "COLLECT_NOW": {
          "goal": "Cerrar pago hoy si es viable; si no, pasar a acuerdo.",
          "primaryAction": "SEND_PAYMENT_LINK",
          "secondaryAction": "SHOW_OFFERS"
        },
        "NEGOTIATE": {
          "goal": "Cerrar un acuerdo y avanzar a pago/promesa.",
          "primaryAction": "SHOW_OFFERS",
          "secondaryAction": "ASK_SLOT"
        },
        "PROMISE": {
          "goal": "Capturar fecha+monto y registrar promesa.",
          "primaryAction": "ASK_SLOT",
          "secondaryAction": "CREATE_PROMISE"
        },
        "NUDGE": {
          "goal": "Confirmar intención sin presionar.",
          "primaryAction": "CLARIFY",
          "secondaryAction": "SHOW_DETAIL"
        },
        "VERIFY": {
          "goal": "Verificar pago/disputa antes de insistir.",
          "primaryAction": "ACK_ALREADY_PAID",
          "secondaryAction": "ACK_DISPUTE"
        }
      },
      "rules": [
        { "when": { "maxDaysPastDue": 7 }, "objective": "NUDGE", "toneKey": "T1" },
        { "when": { "minDaysPastDue": 60 }, "objective": "COLLECT_NOW", "toneKey": "T3" },
        { "when": { "minTotalDueCop": 2000000 }, "objective": "COLLECT_NOW", "toneKey": "T3" }
      ]
    }
  }
}